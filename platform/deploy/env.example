# Poker Run platform configuration.
#
# Copy to platform/deploy/.env (bootstrap.sh does this and fills in the secrets),
# then `chmod 600 .env`. docker compose reads it for ${...} substitution in
# docker-compose.yml and passes it to the api and worker containers as their environment.
#
# Format rules (docker compose .env): one KEY=value per line, comments on their own
# lines only, no spaces around "=", quote values that contain spaces. Do not use "$"
# in values (compose would try to interpolate it).
#
# After editing: `make up` (recreates containers whose config changed).
#
# Generate secrets (any machine with Python 3):
#   PR_SECRET:        python3 -c "import secrets; print(secrets.token_hex(32))"
#                     (or: openssl rand -hex 32)
#   PR_HIDDEN_SEEDS:  python3 -c "import secrets; r=secrets.SystemRandom(); print(','.join(map(str, sorted(r.sample(range(10**6, 4*10**9), 50)))))"
#   PR_INVITE:        python3 -c "import secrets; print(secrets.token_urlsafe(9))"
# Keep a copy of this file (at least PR_HIDDEN_SEEDS) in a password
# manager: the hidden seeds define the final scores and are NOT in the backups.

# ---------------------------------------------------------------- deployment

# Public host name of the contest site. Its DNS A record must point at the Elastic IP.
DOMAIN=pokerrun.example.com

# Extra origins allowed to embed the browser game (/play/) in an iframe, space
# separated, quoted. Example: "https://yourname.com https://www.yourname.com".
# Empty = only the contest site itself may frame it.
FRAME_ANCESTORS=

# S3 bucket for database backups (bucket name only, no s3://). Empty disables uploads.
BACKUP_BUCKET=
# Key prefix inside the bucket. The IAM policy in aws/iam-backup-policy.json is scoped to it.
BACKUP_PREFIX=pokerrun/db/
# Days to keep local backup files in ${POKERRUN_ROOT}/backups. S3 retention is a
# bucket lifecycle rule (aws/s3-lifecycle.json), so the instance never needs delete rights.
BACKUP_KEEP_DAYS=7
# Region of the bucket. Empty = the instance's own region (read from instance metadata).
AWS_REGION=

# Host directory with data/, jobs/, backups/ (bootstrap.sh creates them, owned by uid 10001).
POKERRUN_ROOT=/srv/pokerrun

# Numeric gid of the host's "docker" group, so the worker can use /var/run/docker.sock.
# bootstrap.sh fills it in; by hand: getent group docker | cut -d: -f3
DOCKER_GID=

# ---------------------------------------------------------------- platform (platform/API.md)

# SQLite file inside the containers. docker-compose.yml forces /data/platform.db
# (host: ${POKERRUN_ROOT}/data/platform.db); listed here for completeness.
PR_DB=/data/platform.db

# Server secret, 64 hex chars (see above). Optional: the current server does not use
# it (session cookies are random tokens stored hashed in the DB), but API.md reserves
# it, so bootstrap.sh fills it in. Empty = random per start (a warning in the logs).
PR_SECRET=

# Invite code students need to register. Empty = open registration.
PR_INVITE=CHANGE_ME

# Comma-separated usernames that are admins (lower case). Register these accounts
# yourself right after the first deploy, before anyone else can take the names.
PR_ADMINS=admin

# Contest name shown on the site.
PR_CONTEST_NAME="Poker Run"

# Contest window, ISO 8601 UTC (Z suffix). Full submissions only between them
# (admins exempt). Empty = always open.
# Example: PR_START=2026-12-05T09:00:00Z
PR_START=
PR_END=

# After this time the public leaderboard stops updating (admins still see it live).
# Usually 1 hour before PR_END. Empty = never frozen. Clear it after the contest
# to publish the final standings.
PR_FREEZE=

# Secret seeds for full submissions: comma list and ranges, e.g. 81723,90211,1000-1047.
# SECRET. Generate 50 random ones (see top). Never reuse the dev default 1001-1050.
# Do not change during the contest: relative scores compare runs on the same seeds.
PR_HIDDEN_SEEDS=CHANGE_ME

# Seeds for public (feedback) submissions. These match the public inputs students download.
PR_PUBLIC_SEEDS=1-10

# Seconds per test (wall clock).
PR_TIME_LIMIT=2.0

# Memory per submission, MB (docker --memory and --memory-swap).
PR_MEMORY_MB=1024

# Maximum upload size, KB.
PR_MAX_SOURCE_KB=256

# Full submissions per user per rolling hour.
PR_FULL_PER_HOUR=6

# docker = real sandbox (production). local is for development only and is NOT a
# security boundary. docker-compose.yml forces docker.
PR_SANDBOX=docker

# Docker image of the sandbox, built on the host: make judge-image
PR_JUDGE_IMAGE=poker-run-judge

# Secure cookies (HTTPS). docker-compose.yml forces 1.
PR_SECURE_COOKIES=1

# Server extensions (platform/server/prplatform/config.py):
# judging threads inside the one worker container (run only ONE worker container). Keep <= physical cores and mind memory:
# each running sandbox may use PR_MEMORY_MB. See RUNBOOK.md, "Scaling the judge".
PR_WORKERS=1
# Seconds between queue polls when idle.
PR_POLL_SECONDS=1.0
# Where the worker creates per-submission job dirs. docker-compose.yml forces
# ${POKERRUN_ROOT}/jobs (same path on the host and in the worker container).
# PR_JOB_ROOT=/srv/pokerrun/jobs
